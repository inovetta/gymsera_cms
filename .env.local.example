# The API `next dev` calls, as an origin with no path (the client adds /api/v1). Local development
# only: here it is the staging API; without the variable `next dev` uses http://localhost:3000. A build
# needs it set explicitly and stops without it (NEW-132); production builds use https://api.gymsera.com.
NEXT_PUBLIC_API_URL=https://apistaging.gymsera.com
NEXT_PUBLIC_APP_NAME=GymsEra CMS
# Same "Web application" OAuth client gymsera_web uses — its Authorized
# JavaScript origins (Google Cloud Console → Credentials) must separately
# include this CMS's own origin (e.g. https://cms.gymsera.com), on top of
# whatever origins the website already added. Sign-in here always hits
# /auth/social/google/staff, which never creates a new account and only
# succeeds for an existing GYM_HOST/BRANCH_MANAGER/PLATFORM_ADMIN user — see
# auth.service.js#googleLogin's staffOnly mode.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=852595980857-akglkibm5auiu093lkrcr3cmqgf0oo3q.apps.googleusercontent.com

# Google Maps web key (NEW-140, P9): draws the branch map only (Maps JavaScript API). City, area and
# address search never use it: they go through the API's /places routes and its server key.
# Restrict it in Google Cloud to the Maps JavaScript API and HTTP referrers https://cms.gymsera.com/*
# (and https://cmsstaging.gymsera.com/* for staging). Never commit the value. Empty = no map; the
# coordinates can still be typed.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
