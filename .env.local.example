NEXT_PUBLIC_API_URL=https://apistaging.gymsera.com
NEXT_PUBLIC_APP_NAME=GymsEra CMS
# Same "Web application" OAuth client gymsera_web uses — its Authorized
# JavaScript origins (Google Cloud Console → Credentials) must separately
# include this CMS's own origin (e.g. https://cms.gymsera.com), on top of
# whatever origins the website already added. Sign-in here always hits
# /auth/social/google/staff, which never creates a new account and only
# succeeds for an existing GYM_HOST/BRANCH_MANAGER/PLATFORM_ADMIN user — see
# auth.service.js#googleLogin's staffOnly mode.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=852595980857-akglkibm5auiu093lkrcr3cmqgf0oo3q.apps.googleusercontent.com
