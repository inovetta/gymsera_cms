# The API this CMS build calls, as an origin with no path (the client adds /api/v1).
# REQUIRED for `next build`: the build stops without it (NEW-132, build-env.mjs).
# Production: https://api.gymsera.com   Staging: https://apistaging.gymsera.com
NEXT_PUBLIC_API_URL=https://api.gymsera.com
NEXT_PUBLIC_APP_NAME=GymsEra CMS
NEXT_PUBLIC_GOOGLE_CLIENT_ID=852595980857-akglkibm5auiu093lkrcr3cmqgf0oo3q.apps.googleusercontent.com
NEXT_PUBLIC_GYMSERA_APP_URL=https://gymsera.com

# Google Maps web key (NEW-140, P9): draws the branch map only (Maps JavaScript API). City, area and
# address search never use it: they go through the API's /places routes and its server key.
# Restrict it in Google Cloud to the Maps JavaScript API and HTTP referrers https://cms.gymsera.com/*
# (and https://cmsstaging.gymsera.com/* for staging). Never commit the value. Empty = no map; the
# coordinates can still be typed.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
